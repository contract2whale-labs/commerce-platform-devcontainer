{
  // 이미지 빌드용 정의다. 수강생은 이 파일이 아니라 게시된 이미지를 쓴다.
  "name": "commerce-platform",
  // 같은 폴더의 Dockerfile로 기본 이미지를 만든다. CLI 도구 버전은 Dockerfile ARG에 고정돼 있다.
  "build": {
    "dockerfile": "Dockerfile"
  },
  // 아래 features를 빌드 때 이미지에 함께 굽는다. 수강생 쪽 devcontainer.json에는 features가 없다.
  "features": {
    // 호스트 Docker를 소켓으로 공유해 컨테이너 안에서 docker build를 쓴다.
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {},
    // GitHub CLI(gh)를 설치한다.
    "ghcr.io/devcontainers/features/github-cli:1": {},
    // 팀 표준 언어 런타임을 정확한 버전으로 설치한다.
    "ghcr.io/devcontainers/features/go:1": {
      "version": "1.26.5"
    },
    "ghcr.io/devcontainers/features/node:2": {
      "version": "24.21.0"
    },
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.12.14"
    }
  }
}
